<?xml version="1.0" encoding="utf-8"?>
<!-- Apple's aerial files are signed by Apple Root CA, which Android does not ship. Trust that root
     for Apple's CDN only. The player itself cannot use this trust store, so AerialProxy serves the
     video from 127.0.0.1. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <domain-config>
        <domain includeSubdomains="true">sylvan.apple.com</domain>
        <trust-anchors>
            <certificates src="@raw/apple_root_ca" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
